rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya koleksi milik aplikasi, dan hanya klien yang sudah masuk (anonim) lewat situs ini.
    match /items/{id}  { allow read, write: if request.auth != null; }
    match /users/{id}  { allow read, write: if request.auth != null; }
    match /meta/{id}   { allow read, write: if request.auth != null; }
    match /{other=**}  { allow read, write: if false; }
  }
}
